# Production (cloud build) data source: live platinum tables (labuser_jdw2.gold/platinum).
# Vite loads this file during `vite build` (mode=production) and bakes the value into the
# client bundle, so every deployed app runs live queries. Local dev (`npm run dev`, mode
# development) stays on the bundled sample data unless you create client/.env.local with
# VITE_DATA_SOURCE=platinum. Leave VITE_LLM_EXTRACTION unset (needs extraction stays off).
VITE_DATA_SOURCE=platinum